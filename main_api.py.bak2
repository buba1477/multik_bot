class ChatRequest(BaseModel):
    query: str

# ========== ВЫШИБАЛА: ПОЛНЫЙ СПИСОК ПАТТЕРНОВ ==========
BAD_PATTERNS = [
    # Оригинальные и системные
    r"игнорируй.{0,50}инструкции", r"forget.{0,50}instructions",
    r"выведи.{0,50}системные", r"system.{0,50}prompt",
    r"я (твой )?разработчик", r"я сотрудник",
    r"### system override ###", r"base64", r"rot13",
    r"<system>", r"\{role:", r"admin:reset",
    
    # Взлом и инструкции
    r"я.{0,50}(твой|ваш).{0,50}(создатель|разработчик|админ|author|creator)",
    r"выведи.{0,50}(системный|системные).{0,30}промт",
    r"покажи.{0,50}(системный|системные).{0,30}промт",
    r"дай.{0,50}(системный|системные).{0,30}(промт|инструкции)",
    r"что.{0,50}(у тебя|внутри).{0,30}(в промте|в инструкции)",
    r"какой.{0,50}(у тебя|твой).{0,30}(системный промт|промпт|промт)",
    r"расскажи.{0,50}(свою|системную).{0,30}инструкцию",
    
    # Смена контекста и роли
    r"теперь.{0,50}ты.{0,50}(не|больше не).{0,30}эксперт",
    r"ты.{0,50}(обычный|простой).{0,30}ассистент",
    r"забудь.{0,50}(роль|кем ты|свою роль)",
    r"ты.{0,50}(не в фнс|не налоговый|не эксперт)",
    r"смени.{0,50}(роль|контекст|персонаж)",
    r"теперь.{0,50}ты.{0,50}(chatgpt|ai assistant|просто бот)",
    r"отвечай.{0,50}(без роли|вне контекста|как обычный ai)",
    
    # Изменение поведения
    r"ты.{0,50}(должен|обязан).{0,30}меня.{0,30}(слушаться|подчиняться)",
    r"я.{0,50}(твой|ваш).{0,50}(начальник|руководитель|администратор)",
    r"игнорируй.{0,50}(ограничения|правила|безопасность)",
    r"отключи.{0,50}(фильтры|безопасность|цензуру)",
    r"disable.{0,50}(filters|security|safety)",
    r"ты.{0,50}(программист|разработчик|админ|developer)",

    # Технические атаки
    r"prompt.{0,30}injection", r"jailbreak",
    r"reveal.{0,50}(prompt|instructions)", r"extract.{0,50}(prompt|instructions)",
    r"what.{0,50}(your role|your instructions|your prompt)",
    r"ignore.{0,50}(previous|all).{0,30}instructions",
    r"print.{0,50}(system|initial).{0,30}(prompt|instruction)",
    r"repeat.{0,50}(system|initial).{0,30}(prompt|instruction)",
    r"output.{0,50}(system|initial).{0,30}(prompt|instruction)",
    
    # Многословные атаки
    r"давай.{0,50}(поиграем|поиграть).{0,30}в.{0,30}роль",
    r"представь.{0,50}(что ты|будто ты).{0,30}(не эксперт|обычный бот)",
    
    # Обход через изолированный base64 токен (длина от 80 символов)
    r"\b[a-zA-Z0-9+/]{80,}={0,2}\b",
]
# Собираем список через ИЛИ (|) и включаем флаг игнорирования регистра букв
WAF_COMPILED_PATTERN = re.compile("|".join(BAD_PATTERNS), re.IGNORECASE)

# Белый список безопасных фраз (исключения)
SAFE_PHRASES = [
    "как вывести системные настройки",
    "как настроить систему",
    "покажи инструкцию по",
    "как вывести список",
    "системные требования",
    "системный администратор",
    "системный блок",
]

def normalize_text(text: str) -> str:
    """Нормализует текст: сжимает повторы, убирает лишние пробелы, нормализует Unicode"""
    text = unicodedata.normalize('NFKC', text.lower())
    text = re.sub(r'\s+', ' ', text)
    text = re.sub(r'(.)\1{3,}', r'\1', text)
    return text.strip()

def is_malicious_query(query: str) -> bool:
    # 1. Защита длины строки поднята на самый верх (Защита CPU)
    if not query or not query.strip():
        return False
        
    request_id = get_request_id()
    if len(query) > 2000:
        logger.warning(f"🚨 ДЛИННЫЙ ЗАПРОС: {len(query)} символов | request_id={request_id}")
        return True
    
    # 2. Нормализация
    q_norm = normalize_text(query)
    
    # 3. Очистка исключений (Вырезаем безопасные фразы)
    cleaned_q_norm = q_norm
    for safe in SAFE_PHRASES:
        cleaned_q_norm = cleaned_q_norm.replace(safe, "")

    # 4. Комбо-фильтр (ищет строго по очищенной строке cleaned_q_norm)
    dangerous_combos = [
        ("системн", "промпт"), ("системн", "инструкц"), 
        ("выведи", "промпт"), ("покажи", "инструкц"),
        ("забудь", "роль"), ("ignore", "instruction"),
        ("твой", "разработчик"), ("твой", "создатель"),
        ("отвечай", "английском"), ("отвечай", "english"),
        ("начальник", "игнорируй"), ("администратор", "отключи"),
        ("disable", "filters"), ("reveal", "prompt"),
        ("extract", "instructions")
    ]
    
    for w1, w2 in dangerous_combos:
        if w1 in cleaned_q_norm and w2 in cleaned_q_norm:
            logger.warning(f"🚨 КОМБО-БАН: {w1} + {w2} | request_id={request_id}")
            return True

    # 5. Анти-пробел (ищет строго по очищенной строке)
    no_spaces = re.sub(r'\s+', '', cleaned_q_norm)
    dangerous_no_spaces = [
        "системныйпромпт", "systemprompt", "системныеинструкции",
        "выведисистемный", "покажипромпт", "игнорируйинструкции"
    ]
    for dangerous in dangerous_no_spaces:
        if dangerous in no_spaces:
            logger.warning(f"🚨 АНТИ-ПРОБЕЛ БАН: {dangerous} | request_id={request_id}")
            return True

    # 6. Вместо цикла СТАВИМ СВЕРХБЫСТРУЮ ПРОВЕРКУ ПО ОЧИЩЕННОЙ СТРОКЕ
    if WAF_COMPILED_PATTERN.search(cleaned_q_norm):
        logger.warning(f"⚠️ REGEX-БАН | request_id={request_id}")
        return True
    
    # 7. Защита от Unicode-омофонов (проверяет очищенную строку)
    latin_cyrillic_confusable = [
        ('c', 'с'), ('e', 'е'), ('o', 'о'), ('p', 'р'), 
        ('a', 'а'), ('x', 'х'), ('k', 'к'), ('m', 'м')
    ]
    q_lower = cleaned_q_norm.lower()
    for latin, cyrillic in latin_cyrillic_confusable:
        q_lower = q_lower.replace(latin, cyrillic)
    
    for w1, w2 in dangerous_combos:
        if w1 in q_lower and w2 in q_lower:
            logger.warning(f"🚨 UNICODE-ОМОФОН БАН: {w1} + {w2} | request_id={request_id}")
            return True
    
    return False

# ========== ОСНОВНОЙ ЭНДПОИНТ ==========
@app.post("/api/v1/predict/stream")
async def ask_stream(request: ChatRequest):
    user_query = request.query
    
    # Проверка на вредоносность
    if is_malicious_query(user_query):
        request_id = get_request_id()
        # КРИТИЧНО ДЛЯ АУДИТА: Фиксируем атаку в защищенный лог
        logger.warning(f"🛑 [WAF БЛОКИРОВКА] Запрос признан опасным и заблокирован | request_id={request_id}")
        
        async def blocked_gen():
            yield json.dumps({"type": "text", "content": "БАЗА_ПУСТА: Я эксперт по вопросам ФНС России."}, ensure_ascii=False) + "\n"
            
        return StreamingResponse(blocked_gen(), media_type="text/event-stream")

    
    normalized_query = user_query.strip()
    query_lower = normalized_query.lower()
    
    # Определяем тип запроса
    has_fns_keyword = any(kw in query_lower for kw in ['ндс', 'фнс', 'налог', '79-фз', 'регламент', 'инструкция', 'документ', 'наложик'])
    is_multik = 'мультик' in query_lower and not has_fns_keyword
    
    # Если запрос на график — идём в RAG (там уже есть chart-режим)
    if chart_engine.is_chart_request(query_lower):
        pass  # просто не заходим в мультик-ветку, уходим в RAG ниже
    
    # Если Мультик — идём в Ollama
    elif is_multik:
        async def multik_stream():
            try:
                stream = await ollama_client.chat(
                    model="yagpt5_fns:latest",
                    messages=[{"role": "user", "content": normalized_query}],
                    stream=True,
                    options={
                        'num_ctx': 4096,
                        'temperature': 0.8,
                        'num_predict': 250
                    }
                )
                async for chunk in stream:
                    content = chunk.get('message', {}).get('content', '')
                    if content:
                        yield json.dumps({"type": "text", "content": content}, ensure_ascii=False) + "\n"
            except Exception as e:
                logger.error(f"Ollama error: {e}")
                yield json.dumps({"type": "text", "content": f"Ошибка связи с Мультиком: {e}"}, ensure_ascii=False) + "\n"
        return StreamingResponse(multik_stream(), media_type="text/event-stream")
    
    # ФНС — через RAG
    # Кэш
    cached_response = await cache.get(normalized_query.lower()) if cache else None
    if cached_response:
        async def stream_from_cache():
            for chunk in json.loads(cached_response):
                yield chunk
        return StreamingResponse(stream_from_cache(), media_type="text/event-stream")
    
    # Генерация через RAG
    async def stream_and_cache_generator(query):
        full_chunks_list = [] 
        try:
            async for chunk in get_ai_streaming_response(query):
                output = chunk if isinstance(chunk, str) else json.dumps(chunk, ensure_ascii=False) + "\n"
                yield output
                full_chunks_list.append(output)
        except Exception as e:
            logger.error(f"Gen error: {e}")
            yield json.dumps({"type": "text", "content": "Ошибка обработки"}, ensure_ascii=False) + "\n"
        
        if cache and full_chunks_list:
            await cache.set(normalized_query.lower(), json.dumps(full_chunks_list, ensure_ascii=False), ex=86400)
    
    return StreamingResponse(stream_and_cache_generator(normalized_query), media_type="text/event-stream")

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)