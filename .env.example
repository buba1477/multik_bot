# =========================================================
# .env.example — шаблон конфигурации для docker-compose-chel.yml
# Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env
# =========================================================

# --- Docker Hub ---
# Ваш логин на Docker Hub (используется в docker-compose-chel.yml для образов)
DOCKERHUB_USER=buba1477

# --- Ollama (LLM) ---
# Адрес сервера Ollama. Для Windows-хоста с Docker Desktop обычно:
#   http://host.docker.internal:11434
# Для Linux-хоста, где Ollama запущена на самой машине:
#   http://host.docker.internal:11434
# Если Ollama в отдельном контейнере — укажите его имя/адрес.
OLLAMA_HOST=http://host.docker.internal:11434

# --- Qdrant (база знаний) ---
# Хост и порт Qdrant. Внутри docker-compose это имя сервиса "qdrant".
# Менять не нужно, если используете docker-compose-chel.yml.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Имя коллекции (по умолчанию fns_collection)
# QDRANT_COLLECTION=fns_collection

# --- Redis (кэш) ---
# Хост и порт Redis. Внутри docker-compose это имя сервиса "redis".
REDIS_HOST=redis
# Пароль Redis (если задан в конфиге Redis)
REDIS_PASSWORD=Redis

# --- Отладка ---
# Включить подробный дамп отладки RAG (true/false)
DEBUG_MODE=false

# --- Telegram-бот (НЕ используется в API-образе, оставлено для справки) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_PROXY_URL=